# Build stage
FROM node:18-alpine AS build

WORKDIR /app

COPY match_prediction_app-front/package*.json ./

RUN npm install

COPY match_prediction_app-front/ .

RUN npm run build

# Production stage
FROM nginx:alpine

COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]