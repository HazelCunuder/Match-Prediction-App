# Variables d'environnement (copie ce fichier en `.env` avant de lancer)

# --- Bases de données ---
# API Application (auth, historique, favoris)
DATABASE_APP_URL=postgresql://postgres:postgres@localhost:5432/footballapp_db

# API ML (matchs, entraînement, prédiction)
DATABASE_ML_URL=postgresql://postgres:postgres@localhost:5432/footballprediction_db

# --- Auth JWT (API Application seulement) ---
SECRET_KEY=change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

MLFLOW_TRACKING_URI=sqlite:///mlflow.db

# --- HTTPS Configuration ---
# Frontend will redirect HTTP to HTTPS automatically
# For development: Use self-signed certificates (run ./generate-certs.sh)
# For production: Use Let's Encrypt or trusted CA certificates
ENABLE_HTTPS=true
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/key.pem