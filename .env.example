# Variables d'environnement (copie ce fichier en `.env` avant de lancer)

# --- Bases de données ---
# PostgreSQL - App Database
POSTGRES_PASSWORD_APP=your_secure_password_here
POSTGRES_DB_APP=footballapp_db

# PostgreSQL - ML Database
POSTGRES_PASSWORD_ML=your_secure_password_here
POSTGRES_DB_ML=footballprediction_db

# API Application (auth, historique, favoris)
DATABASE_APP_URL=postgresql://postgres:${POSTGRES_PASSWORD_APP}@postgres-app:5432/${POSTGRES_DB_APP}

# API ML (matchs, entraînement, prédiction)
DATABASE_ML_URL=postgresql://postgres:${POSTGRES_PASSWORD_ML}@postgres-ml:5433/${POSTGRES_DB_ML}
